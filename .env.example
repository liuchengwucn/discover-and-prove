# Copy to .env and fill in. Loaded automatically via python-dotenv.

# --- Reasoning LLM + judge (OpenAI-compatible endpoint) ---
# Used by the Discovery Module (gpt-oss-120b), the Rewriting step, and the
# Table 3 answer judge (gemini-2.5-flash). The model names in models.py are
# OpenRouter-style (e.g. "openai/gpt-oss-120b", "google/gemini-2.5-flash"), so
# point this at OpenRouter or any gateway that serves those names.
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Proving Module: self-hosted Goedel-Prover-V2-32B ---
# Any OpenAI-compatible server (e.g. vLLM serving the model below).
GOEDEL_BASE_URL=http://localhost:8000/v1
GOEDEL_API_KEY=EMPTY
GOEDEL_MODEL_ID=Goedel-LM/Goedel-Prover-V2-32B

# --- Lean 4 verification: Kimina server (mediates the Lean 4 REPL) ---
KIMINA_API_URL=http://localhost:12332
